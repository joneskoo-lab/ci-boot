#cloud-config
# Unattended Ubuntu Server 26.04 LTS install for the home Firecracker host. Public file: it must never contain secrets.
# Use: boot the stock ISO in UEFI mode, press e on "Try or Install Ubuntu Server", add before "---" and press F10:
#   autoinstall ds=nocloud\;s=https://raw.githubusercontent.com/joneskoo-lab/ci-boot/main/
# It WIPES the largest disk without asking. Result: host fc-home, no SSH server, no password login,
# and a Tailscale login QR code on the console at every boot until the host has joined the tailnet.
autoinstall:
  version: 1
  keyboard: {layout: fi}
  timezone: Europe/Helsinki
  kernel: {package: linux-generic}
  ssh: {install-server: false}
  storage:
    config:
      - {type: disk, id: disk0, ptable: gpt, wipe: superblock-recursive, preserve: false, match: {size: largest}}
      - {type: partition, id: esp, device: disk0, size: 1G, flag: boot, grub_device: true}
      - {type: format, id: esp-fs, volume: esp, fstype: fat32}
      - {type: mount, id: esp-mount, device: esp-fs, path: /boot/efi}
      - {type: partition, id: root, device: disk0, size: 40G}
      - {type: format, id: root-fs, volume: root, fstype: ext4}
      - {type: mount, id: root-mount, device: root-fs, path: /}
      # The rest of the disk, unformatted: runner storage. bootstrap.sh takes it as POOL_DEV=/dev/disk/by-partlabel/fcpool
      - {type: partition, id: pool, device: disk0, size: -1, partition_name: fcpool}
  # Subiquity drops partition_name from the storage config, so name the pool partition (3rd on the root disk) here.
  late-commands:
    - sh -c 'd=/dev/$(lsblk -no PKNAME "$(findmnt -no SOURCE /target)"); sfdisk --no-reread --part-label "$d" 3 fcpool'
    # Optional unattended join: a USB stick labelled FCJOIN holding ts-authkey (from the mint-join-key workflow).
    - sh -c 'd=$(blkid -L FCJOIN) || exit 0; mkdir -p /run/fcjoin && mount -o ro "$d" /run/fcjoin && [ -s /run/fcjoin/ts-authkey ] && install -m 600 /run/fcjoin/ts-authkey /target/etc/fc-join.key; umount /run/fcjoin; true'
  # Tailscale comes from its own apt repository during the install, so first boot needs no download.
  apt:
    sources:
