  packages: [tailscale]
  user-data:          # first boot of the installed system
    hostname: fc-home
    manage_etc_hosts: true
    write_files:
      - path: /usr/local/sbin/fc-join
        permissions: "0755"
        content: |
          #!/bin/sh
          # Show the Tailscale login QR code on tty1 until this host is in the tailnet.
          # getty can clear tty1 after the code is drawn, so redraw it until the login completes.
          # Output goes to a file, so force full blocks: "auto" falls back to "#" characters off a terminal.
          tailscale status >/dev/null 2>&1 && exit 0
          say() { echo "$*"; echo "$*" >/dev/tty1; }
          # A single-use key from the FCJOIN install stick joins without anyone at the console; it is deleted either way.
          key=/etc/fc-join.key
          if [ -s "$key" ]; then
            say "Joining the tailnet with the key from the install stick"
            if timeout 120 tailscale up --auth-key="file:$key" --ssh >/run/fc-join.log 2>&1; then
              rm -f "$key"; say "Joined the tailnet"; exit 0
            fi
            rm -f "$key"; say "The join key was rejected, showing the QR code instead: $(cat /run/fc-join.log)"; sleep 10
          fi
          qr=/run/fc-join.qr
          tailscale up --qr --qr-format=large --ssh --advertise-tags=tag:github-actions-host,tag:ssh >"$qr" 2>&1 &
          up=$!
          sleep 5
          while kill -0 "$up" 2>/dev/null; do
            { printf '\033[H\033[2J'; cat "$qr"; } >/dev/tty1
            sleep 20
          done
          wait "$up" && exit 0
          { echo "tailscale up failed, retrying:"; cat "$qr"; } >/dev/tty1
          exit 1
      - path: /etc/systemd/system/fc-join.service
        content: |
          [Unit]
          Description=Join the tailnet: login QR code on the console until this host is in
          After=network-online.target tailscaled.service
          Wants=network-online.target tailscaled.service

          [Service]
          Type=simple
          ExecStart=/usr/local/sbin/fc-join
          Restart=on-failure
          RestartSec=15

          [Install]
          WantedBy=multi-user.target
    runcmd:
      - systemctl enable --now --no-block fc-join.service
